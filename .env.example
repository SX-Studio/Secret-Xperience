# SecretXperience.eu — every environment variable the code reads.
# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Supabase (required; the app does not start without these) ---------------
NEXT_PUBLIC_SUPABASE_URL=
# The code reads both of these. Newer Supabase dashboards call the key
# "publishable"; older ones call the same thing "anon". Set both to that key
# until the code has settled on one name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for server-to-server calls between our own API routes.
# It has a hardcoded fallback in the code, so set it in every environment.
INTERNAL_SECRET=
# Read in the browser by app/listings/create/page.tsx, so whatever is put here
# is visible to every visitor. See the note in the README before relying on it.
NEXT_PUBLIC_INTERNAL_SECRET=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Phone verification (Twilio Verify) ---------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Live video (LiveKit) -----------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Live recordings (S3-compatible storage) ----------------------------------
LIVE_REC_S3_ENDPOINT=
LIVE_REC_S3_REGION=
LIVE_REC_S3_BUCKET=
LIVE_REC_S3_ACCESS_KEY=
LIVE_REC_S3_SECRET=
LIVE_REC_PUBLIC_BASE=

# --- Payments: cards (Stripe) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments: high risk (CCBill) ---------------------------------------------
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUBACC=
CCBILL_FLEXFORM_NAME=
CCBILL_SALT=
CCBILL_API_CLIENT_ID=
CCBILL_API_CLIENT_SECRET=

# --- Payments: high risk (Verotel) --------------------------------------------
VEROTEL_SHOP_ID=
VEROTEL_SIGNATURE_KEY=

# --- Payments: crypto (NOWPayments) -------------------------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Payouts (Stripcash) ------------------------------------------------------
STRIPCASH_USER_ID=
STRIPCASH_API_KEY=

# --- Content moderation (Anthropic) -------------------------------------------
ANTHROPIC_API_KEY=

# --- Affiliate links ----------------------------------------------------------
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_LASTMINUTE_URL=
NEXT_PUBLIC_LASTMINUTE_AFF=

# --- SEO tooling (scripts/) ---------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
